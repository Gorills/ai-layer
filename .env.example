# Variable reference only: AI Layer does not auto-load repository .env files.
# Export overrides explicitly in the process/shell environment.
AI_LAYER_DATABASE_URL=postgresql+psycopg://ai_layer:ai_layer@127.0.0.1:54329/ai_layer
AI_LAYER_EMBEDDING_PROVIDER=fastembed
AI_LAYER_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# v0.1.x PostgreSQL schema is fixed at VECTOR(384).
AI_LAYER_EMBEDDING_DIMENSIONS=384
AI_LAYER_SCAN_MAX_FILE_BYTES=524288
AI_LAYER_SCAN_MAX_FILES=10000
